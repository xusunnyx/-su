# ---- 运行模式 ----
# row    = 共享库行级隔离（默认）
# schema = 每个租户一个独立库
TENANT_ISOLATION=row
DATA_DIR=data

# ---- 基础设施（不填则自动降级为 SQLite + 进程内缓存）----
# DATABASE_URL=postgresql+psycopg://adflow:adflow@localhost:5432/adflow
# REDIS_URL=redis://localhost:6379/0

# ---- 业务参数 ----
RATE_LIMIT=120
RATE_WINDOW=60
CACHE_TTL=15
IDEMPOTENCY_TTL=86400
WORKER_ENABLED=true
WORKER_INTERVAL=0.5
CURRENCY=USD

# ---- 管理面 ----
ADMIN_TOKEN=dev-admin-token

# ---- 日志 ----
LOG_LEVEL=INFO
